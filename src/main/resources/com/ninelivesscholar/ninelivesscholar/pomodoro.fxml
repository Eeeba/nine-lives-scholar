<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: gray;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ninelivesscholar.ninelivesscholar.PomodoroController">
   <children>
      <Label layoutX="25.0" layoutY="25.0" text="Pomodoro Timer Setup">
         <font>
            <Font name="Source Code Pro Bold" size="24.0" />
         </font></Label>
      <TextField alignment="CENTER" blendMode="SRC_ATOP" layoutX="25.0" layoutY="100.0" promptText="00:00">
         <font>
            <Font name="Source Code Pro Bold" size="24.0" />
         </font></TextField>
      <Label layoutX="25.0" layoutY="80.0" text="Work">
         <font>
            <Font name="Source Code Pro Italic" size="12.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
